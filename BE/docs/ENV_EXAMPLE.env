# =============================================================================
# BACKEND ENVIRONMENT CONFIGURATION (SAMPLE)
# Dự án: Nhaxuong - Sàn Giao Dịch Nhà Xưởng & BĐS Công Nghiệp
# =============================================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
FRONTEND_CORS_URL=http://localhost:5173

# Database Connection (SQL Server, PostgreSQL or MySQL)
DATABASE_URL="Server=localhost,1433;Database=NhaxuongDb;User Id=sa;Password=YourPassword123!;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=true"

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_key_nhaxuong_2026_industrial_real_estate
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=refresh_super_secret_key_987654321
JWT_REFRESH_EXPIRES_IN=30d

# Redis (Message Queue & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email / SMTP Newsletter Service (Gmail API / SendGrid / AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=newsletter@nhaxuong.vn
SMTP_PASS=your_app_password
EMAIL_FROM="Nhaxuong System <newsletter@nhaxuong.vn>"

# Storage Service (AWS S3 / Cloudinary / MinIO for Drone Video & MP3 Audio)
STORAGE_DRIVER=local # local | s3 | cloudinary
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=nhaxuong-media
