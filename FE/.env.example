# Application Configuration
VITE_APP_TITLE=Nhà Xưởng & Sắt Thép Tái Sử Dụng
VITE_APP_DESCRIPTION=Nền tảng giao dịch & cho thuê kho bãi, nhà xưởng, sắt thép tái sử dụng toàn quốc

# API Base URL
VITE_API_BASE_URL=https://nhaxuong-backend.onrender.com/api
VITE_API_TIMEOUT=30000

# Mock Mode (Set to false to connect directly to the live backend and database)
VITE_USE_MOCK_API=false

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Firebase Phone Auth (Free 10,000 SMS OTP/month)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
